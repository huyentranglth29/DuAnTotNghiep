GOOGLE_CLIENT_ID=610098112221-81itiqbuku3n1acfnq863j2r5mg572ci.apps.googleusercontent.com

# Email thông báo đăng nhập (SMTP; để trống nếu chưa muốn bật)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="FilmGo <your-email@gmail.com>"

VNP_TMN_CODE=
